        {
          "name": "Spend Points",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/points/spend?userId=100&points=300&category=PURCHASE&description=Buy item&referenceId=10",
              "host": ["{{base_url}}"],
              "path": ["api", "points", "spend"],
              "query": [
                {
                  "key": "userId",
                  "value": "100"
                },
                {
                  "key": "points",
