{
  "info": {
    "_postman_id": "snail-backend-api-test-collection",
    "name": "Snail Project Backend API Test Collection",
    "description": "Snail 项目后端 API 接口测试集合\n\n包含以下模块的测试：\n- 认证 API (注册/登录/登出)\n- 任务 API (列表/详情/创建/更新/删除)\n- 用户任务 API (分配/完成/状态更新)\n- 积分 API (余额/流水查询)\n- 用户管理 API (列表/详情/更新/删除)\n\n作者：后端测试工程师\n创建日期：2026-03-30",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testTaskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "认证 API (Auth)",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_{{timestamp}}\",\n  \"email\": \"test{{timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"返回 accessToken\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.exist;",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
