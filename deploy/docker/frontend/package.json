{
  "name": "snail-h5-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "蜗牛 H5 应用 - 移动端 Web App",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.0",
    "vant": "^4.8.0",
    "weixin-js-sdk": "^1.6.0",
    "@vant/use": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "@playwright/test": "^1.40.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vue-tsc": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0",
    "vitest": "^1.3.0",
    "vite-plugin-pwa": "^0.19.0",
    "workbox-window": "^7.0.0",
    "postcss-px-to-viewport": "^1.1.1",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "iOS >= 12",
    "Android >= 5",
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
